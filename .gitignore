# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Model binaries. These are regenerated by `python train.py` and are far too
# large for git: the regressor is 631 MB and the classifier 156 MB, both over
# GitHub's 100 MB per-file hard limit. The pipeline rebuilds them from
# data/diamonds.csv in a few minutes, so nothing is lost.
artifacts/*.joblib

# Derived data, also rebuilt by train.py
artifacts/_full_clean.csv

# Local experiments that are not part of the deliverable
checks.py
facts.py
measure_compact.py
check_leaf_claim.py

# Node / Next.js
web/node_modules/
web/.next/
web/out/
web/.vercel/
web/.turbo/
web/next-env.d.ts
npm-debug.log*
yarn-error.log*

# Local environment. Contains the local FastAPI port only, but keep secrets
# out of git as a standing rule.
web/.env.local
web/.env*.local

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch images produced while checking the rendered page
shot.jpg
slice*.jpg
